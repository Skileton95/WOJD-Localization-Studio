<UserControl x:Class="WOJD.LocalizationStudio.Views.QaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="860" MinHeight="520">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2F7DF4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#40516C"/>
            <Setter Property="BorderBrush" Value="#DCE4EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Типы проблем" FontSize="16" FontWeight="SemiBold" Margin="4,2,0,12"/>
                <ListBox x:Name="CategoryList" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="CategoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5,7" MinHeight="28">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Border Grid.Column="1" Background="#EEF4FE" CornerRadius="9" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Count, StringFormat=N0}" Foreground="#2F6FD4" FontSize="11"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="3,0,3,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="IssueTitleText" Text="Все проблемы" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="IssueCountText" Grid.Column="1" Foreground="#7C8AA1"/>
                </Grid>
                <DataGrid x:Name="IssueGrid" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" HeadersVisibility="Column"
                          RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF1F6"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionMode="Single"
                          SelectionChanged="IssueGrid_SelectionChanged"
                          MouseDoubleClick="IssueGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="72"/>
                        <DataGridTextColumn Header="Original" Binding="{Binding OriginalDisplay}" Width="*"/>
                        <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="210"/>
                        <DataGridTextColumn Header="QA" Binding="{Binding QaIndicator}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailStateText" Text="Выберите проблему" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="IssuePositionText" Grid.Column="1" Foreground="#8A96A8" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Row="1" Margin="0,14,0,0" Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="DetailOriginalText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailKeyText" Foreground="#76859D" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="Причина" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DetailReasonText" Foreground="#5F6F89" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Перевод" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Ctrl+Enter — применить" Foreground="#8A96A8" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Background="White" BorderBrush="#AFC3E8" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,7,0,0">
                        <TextBox x:Name="DetailTranslationBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="130"
                                 IsEnabled="False"
                                 LostKeyboardFocus="DetailTranslationBox_LostKeyboardFocus"
                                 PreviewKeyDown="DetailTranslationBox_PreviewKeyDown"/>
                    </Border>
                    <TextBlock Margin="0,6,0,0" Foreground="#8A96A8" FontSize="11" TextWrapping="Wrap"
                               Text="Правка сохраняется при переходе на другую проблему. «Применить и дальше» не запускает полный пересчёт 600k строк."/>
                </StackPanel>
                <WrapPanel Grid.Row="4" Margin="0,12,0,0">
                    <Button x:Name="ApplyTranslationButton"
                            Style="{StaticResource ActionButton}"
                            Content="Применить"
                            IsEnabled="False"
                            Margin="0,0,7,7"
                            Click="ApplyTranslation_Click"/>
                    <Button x:Name="ApplyAndNextButton"
                            Style="{StaticResource ActionButton}"
                            Content="Применить и дальше"
                            IsEnabled="False"
                            Margin="0,0,7,7"
                            Click="ApplyAndNext_Click"/>
                    <Button x:Name="PreviousIssueButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="←"
                            IsEnabled="False"
                            Margin="0,0,5,7"
                            ToolTip="Предыдущая проблема"
                            Click="PreviousIssue_Click"/>
                    <Button x:Name="NextIssueButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="→"
                            IsEnabled="False"
                            Margin="0,0,7,7"
                            ToolTip="Следующая проблема"
                            Click="NextIssue_Click"/>
                    <Button x:Name="OpenInEditorButton"
                            Style="{StaticResource SecondaryButton}"
                            Content="Открыть в редакторе"
                            IsEnabled="False"
                            Margin="0,0,0,7"
                            Click="OpenInEditor_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
