<UserControl x:Class="WOJD.LocalizationStudio.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760" MinHeight="520">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#EEF4FE"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F7DF4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="BorderBrush" Value="#E3E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
            <StackPanel>
                <TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold" Margin="10,5,0,12"/>
                <Button Style="{StaticResource CategoryButton}" Content="⚙  Общие" Tag="General" Click="Category_Click"/>
                <Button Style="{StaticResource CategoryButton}" Content="▣  Файлы" Tag="Files" Click="Category_Click"/>
                <Button Style="{StaticResource CategoryButton}" Content="◐  Внешний вид" Tag="Appearance" Click="Category_Click"/>
                <Button Style="{StaticResource CategoryButton}" Content="⌨  Горячие клавиши" Tag="Hotkeys" Click="Category_Click"/>
                <Button Style="{StaticResource CategoryButton}" Content="⟲  Резервные копии" Tag="Backups" Click="Category_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="GeneralPanel">
                            <TextBlock Text="Общие" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Язык интерфейса" Margin="0,22,0,6"/>
                            <ComboBox IsEnabled="False" SelectedIndex="0" Width="220" HorizontalAlignment="Left" Padding="8,5"><ComboBoxItem Content="Русский"/></ComboBox>
                            <TextBlock Text="Интерфейс программы сейчас русскоязычный." Foreground="#7B899F" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="FilesPanel" Visibility="Collapsed">
                            <TextBlock Text="Файлы" FontSize="20" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource SettingCard}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Поддерживаемые форматы" FontWeight="SemiBold"/>
                                    <TextBlock Text="NDJSON / JSONL" Foreground="#5F6F89" Margin="0,5,0,0"/>
                                    <TextBlock Text="Сохранение выполняется через временный файл с проверкой и резервной копией." Foreground="#7B899F" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                            <TextBlock Text="Внешний вид" FontSize="20" FontWeight="SemiBold"/>

                            <Border Style="{StaticResource SettingCard}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Редактор перевода" FontWeight="SemiBold"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="Размер шрифта" VerticalAlignment="Center" Margin="0,5"/>
                                        <TextBox x:Name="FontSizeBox" Grid.Column="1" Padding="8,6"/>
                                        <CheckBox x:Name="WrapCheckBox" Grid.Row="1" Grid.ColumnSpan="3" Content="Переносить длинные строки" Margin="0,12,0,0"/>
                                        <CheckBox x:Name="QaDetailsCheckBox" Grid.Row="2" Grid.ColumnSpan="3" Content="Показывать подробности QA под редактором" Margin="0,10,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingCard}">
                                <StackPanel>
                                    <TextBlock Text="Рабочая область" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="ShowContextCheckBox" Content="Показывать правую панель контекста" Margin="0,12,0,0"/>
                                    <CheckBox x:Name="CompactListCheckBox" Content="Компактный список строк" Margin="0,10,0,0"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Text="Ширина списка строк" VerticalAlignment="Center" Margin="0,5"/>
                                        <TextBox x:Name="ListWidthBox" Grid.Column="1" Padding="8,6"/>
                                        <TextBlock Grid.Column="2" Text="250–700 px" Foreground="#7B899F" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <TextBlock Grid.Row="1" Text="Ширина контекста" VerticalAlignment="Center" Margin="0,10,0,5"/>
                                        <TextBox x:Name="ContextWidthBox" Grid.Row="1" Grid.Column="1" Padding="8,6" Margin="0,5,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="240–620 px" Foreground="#7B899F" VerticalAlignment="Center" Margin="10,5,0,0"/>
                                    </Grid>
                                    <TextBlock Text="Ширину также можно менять мышью прямо в разделе «Перевод». Новые размеры сохраняются автоматически." Foreground="#7B899F" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="HotkeysPanel" Visibility="Collapsed">
                            <TextBlock Text="Горячие клавиши" FontSize="20" FontWeight="SemiBold"/>
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Открыть файл" Margin="0,5"/><TextBlock Grid.Column="1" Text="Ctrl+O" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="1" Text="Открыть папку" Margin="0,5"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl+Shift+O" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="2" Text="Сохранить" Margin="0,5"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Ctrl+S" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="3" Text="Отменить / повторить" Margin="0,5"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Ctrl+Z / Ctrl+Y" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="4" Text="Поиск в текущем файле" Margin="0,5"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Ctrl+F" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="5" Text="Поиск по проекту" Margin="0,5"/><TextBlock Grid.Row="5" Grid.Column="1" Text="Ctrl+Shift+F" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="6" Text="Следующая непереведённая" Margin="0,5"/><TextBlock Grid.Row="6" Grid.Column="1" Text="F6 / Shift+F6" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="7" Text="Следующая QA-проблема" Margin="0,5"/><TextBlock Grid.Row="7" Grid.Column="1" Text="F7 / Shift+F7" FontWeight="SemiBold" Margin="0,5"/>
                                <TextBlock Grid.Row="8" Text="Справка" Margin="0,5"/><TextBlock Grid.Row="8" Grid.Column="1" Text="F1" FontWeight="SemiBold" Margin="0,5"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="BackupsPanel" Visibility="Collapsed">
                            <TextBlock Text="Резервные копии" FontSize="20" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource SettingCard}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Автоматическая защита" FontWeight="SemiBold"/>
                                    <TextBlock Text="При сохранении и опасных массовых операциях программа создаёт резервные копии/снимки. Хранятся последние 10 версий для каждого файла." Foreground="#5F6F89" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock Text="Файловые .bak находятся рядом с исходным файлом в папке .localization-backups. Снимки операций хранятся отдельно в служебных данных программы." Foreground="#7B899F" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock x:Name="SavedText" Foreground="#28935B" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить настройки" HorizontalAlignment="Right" Click="Save_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
