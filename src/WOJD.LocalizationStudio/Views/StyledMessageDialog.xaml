<Window x:Class="WOJD.LocalizationStudio.Views.StyledMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Margin="14"
            Background="White"
            BorderBrush="{StaticResource BorderBrushApp}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="6"
                              Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{StaticResource BackgroundBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="8"
                            Background="{StaticResource AccentSoftBrush}"
                            Margin="0,0,10,0">
                        <TextBlock Text="译"
                                   FontSize="16"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="×"
                        FontSize="20"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="24,22,24,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge"
                        Width="36"
                        Height="36"
                        CornerRadius="10"
                        Background="{StaticResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               Text="i"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           Margin="8,3,0,0"
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,20,24,24">
                <Button x:Name="SecondaryButton"
                        Width="112"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        Click="Secondary_Click"/>
                <Button x:Name="PrimaryButton"
                        Width="122"
                        Style="{StaticResource PrimaryButton}"
                        Click="Primary_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
