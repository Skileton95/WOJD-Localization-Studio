<Window x:Class="WOJD.LocalizationStudio.Views.ProjectReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Массовая замена по проекту"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Массовая замена по проекту"
                       FontSize="22"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Изменяется только поле перевода. Перед применением показывается полный список будущих изменений."
                       Margin="0,5,0,14"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Найти"/>
                <TextBox x:Name="QueryBox"
                         Padding="9,7"
                         Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="8,0">
                <TextBlock Text="Заменить на"/>
                <TextBox x:Name="ReplacementBox"
                         Padding="9,7"
                         Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Margin="12,20,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <CheckBox x:Name="MatchCaseBox"
                          Content="Регистр"
                          Margin="0,0,10,0"/>
                <CheckBox x:Name="WholeWordBox"
                          Content="Целое слово"
                          Margin="0,0,10,0"/>
                <CheckBox x:Name="RegexBox"
                          Content="Regex"
                          Margin="0,0,12,0"/>
                <Button Content="Предпросмотр"
                        Style="{StaticResource PrimaryButton}"
                        Padding="14,8"
                        Click="Preview_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <DataGrid x:Name="PreviewGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓"
                                            Binding="{Binding IsSelected}"
                                            Width="45"/>
                    <DataGridTextColumn Header="Файл"
                                        Binding="{Binding FileName}"
                                        IsReadOnly="True"
                                        Width="160"/>
                    <DataGridTextColumn Header="Namespace"
                                        Binding="{Binding Namespace}"
                                        IsReadOnly="True"
                                        Width="180"/>
                    <DataGridTextColumn Header="Key"
                                        Binding="{Binding Key}"
                                        IsReadOnly="True"
                                        Width="110"/>
                    <DataGridTextColumn Header="Оригинал"
                                        Binding="{Binding Original}"
                                        IsReadOnly="True"
                                        Width="*"/>
                    <DataGridTextColumn Header="Было"
                                        Binding="{Binding CurrentTranslation}"
                                        IsReadOnly="True"
                                        Width="*"/>
                    <DataGridTextColumn Header="Будет"
                                        Binding="{Binding NewTranslation}"
                                        IsReadOnly="True"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Закрыть"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Click="Close_Click"/>

            <Button Grid.Column="2"
                    Content="Применить выбранные"
                    Style="{StaticResource PrimaryButton}"
                    Padding="16,8"
                    Click="Apply_Click"/>
        </Grid>
    </Grid>
</Window>
