<UserControl x:Class="WOJD.LocalizationStudio.Views.StatisticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="780" MinHeight="500">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Всего строк" Foreground="#71809A"/><TextBlock x:Name="TotalText" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Переведено" Foreground="#71809A"/><TextBlock x:Name="TranslatedText" FontSize="28" FontWeight="SemiBold" Foreground="#20965A" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="Без перевода" Foreground="#71809A"/><TextBlock x:Name="UntranslatedText" FontSize="28" FontWeight="SemiBold" Foreground="#D47B19" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="QA-проблемы" Foreground="#71809A"/><TextBlock x:Name="ErrorText" FontSize="28" FontWeight="SemiBold" Foreground="#D94C55" Margin="0,5,0,0"/></StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Прогресс текущего файла" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="FileNameText" Foreground="#71809A" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="26" FontWeight="SemiBold" Foreground="#2F7DF4" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Grid.Row="1" x:Name="CompletionProgress" Height="9" Minimum="0" Maximum="100" Margin="0,16,0,0"/>
                </Grid>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Namespace" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DataGrid x:Name="NamespaceGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF1F6" MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Namespace" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Всего" Binding="{Binding Total, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="Переведено" Binding="{Binding Translated, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="QA" Binding="{Binding Errors, StringFormat=N0}" Width="80"/>
                                <DataGridTextColumn Header="%" Binding="{Binding Percent, StringFormat={}{0:0.0}%}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Текущее состояние" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Изменено после сохранения" Foreground="#71809A" Margin="0,18,0,0"/>
                        <TextBlock x:Name="ModifiedText" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Структурные ошибки" Foreground="#71809A" Margin="0,18,0,0"/>
                        <TextBlock x:Name="StructuralText" FontSize="22" FontWeight="SemiBold" Foreground="#D94C55"/>
                        <TextBlock Text="Предупреждения глоссария" Foreground="#71809A" Margin="0,18,0,0"/>
                        <TextBlock x:Name="GlossaryText" FontSize="22" FontWeight="SemiBold" Foreground="#D47B19"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
