<Window x:Class="WOJD.LocalizationStudio.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="620"
        Height="620"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Настройки"
                       FontSize="24"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Интерфейс, резервные копии и горячие клавиши."
                       Margin="0,5,0,18"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Интерфейс"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Тема"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="ThemeBox"
                              Grid.Column="1"
                              Padding="8,6">
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Размер шрифта"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="FontSizeBox"
                             Grid.Column="1"
                             Padding="8,6"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ширина панели файлов"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="FilesWidthBox"
                             Grid.Column="1"
                             Padding="8,6"/>
                </Grid>

                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Хранить backup на файл"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="BackupLimitBox"
                             Grid.Column="1"
                             Padding="8,6"/>
                </Grid>

                <TextBlock Text="Горячие клавиши"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Поиск по проекту"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="ProjectSearchHotkeyBox"
                             Grid.Column="1"
                             Padding="8,6"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Следующая непереведённая"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="NextHotkeyBox"
                             Grid.Column="1"
                             Padding="8,6"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Предыдущая непереведённая"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="PreviousHotkeyBox"
                             Grid.Column="1"
                             Padding="8,6"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Сохранить всё"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="SaveAllHotkeyBox"
                             Grid.Column="1"
                             Padding="8,6"/>
                </Grid>

                <TextBlock Text="Формат: Ctrl+Shift+F, F6, Shift+F6. Настройки применяются после сохранения; основные сочетания также показаны в меню."
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Сбросить"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Click="Reset_Click"/>
            <Button Content="Отмена"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="Сохранить"
                    Style="{StaticResource PrimaryButton}"
                    Padding="18,8"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
