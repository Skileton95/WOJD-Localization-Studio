<Window x:Class="WOJD.LocalizationStudio.Views.BackupHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История резервных копий"
        Width="820"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="История резервных копий"
                       FontSize="22"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Margin="0,5,0,12"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <DataGrid x:Name="BackupsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата"
                                    Binding="{Binding CreatedLocal}"
                                    Width="180"/>
                <DataGridTextColumn Header="Размер"
                                    Binding="{Binding Size, StringFormat={}{0:N0} байт}"
                                    Width="130"/>
                <DataGridTextColumn Header="Файл"
                                    Binding="{Binding Path}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Закрыть"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16,8"
                    Margin="0,0,8,0"
                    Click="Close_Click"/>
            <Button Content="Восстановить"
                    Style="{StaticResource PrimaryButton}"
                    Padding="16,8"
                    Click="Restore_Click"/>
        </StackPanel>
    </Grid>
</Window>
