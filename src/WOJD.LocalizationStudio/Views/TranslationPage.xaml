<UserControl x:Class="WOJD.LocalizationStudio.Views.TranslationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="900" MinHeight="560">
    <UserControl.Resources>
        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E6EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#52627D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*" MinWidth="430"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#F6F8FC" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="8" Height="42">
                    <Grid>
                        <TextBlock Text="⌕" FontSize="20" Foreground="#8B98AD" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="38,10,10,8" ToolTip="Поиск по тексту, ключу или Namespace"/>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="1" Margin="0,10,0,10">
                    <Button Style="{StaticResource FilterChip}" Command="{Binding FilterAllCommand}">
                        <TextBlock><Run Text="Все "/><Run Text="{Binding TotalCount}" FontWeight="SemiBold"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FilterChip}" Command="{Binding FilterUntranslatedCommand}">
                        <TextBlock><Run Text="Без перевода "/><Run Text="{Binding UntranslatedCount}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FilterChip}" Command="{Binding FilterTranslatedCommand}">
                        <TextBlock><Run Text="С переводом "/><Run Text="{Binding TranslatedCount}"/></TextBlock>
                    </Button>
                </WrapPanel>

                <DataGrid x:Name="EntriesGrid"
                          Grid.Row="2"
                          ItemsSource="{Binding EntriesView}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          Background="Transparent"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF1F6"
                          AlternatingRowBackground="#FBFCFE"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="EntriesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Исходный текст / ключ" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding OriginalDisplay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Key}" FontSize="11" Foreground="#8290A7" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding QaIndicator}" Margin="10,0,3,0" VerticalAlignment="Center" FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2CBF76"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasStructuralValidationIssues}" Value="True"><Setter Property="Foreground" Value="#E34C55"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding HasValidationIssues}" Value="True"><Setter Property="Foreground" Value="#E29A24"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedEntry.Key}" FontSize="22" FontWeight="SemiBold" Foreground="#17233C" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="EntryMetaText" Margin="0,4,0,0" Foreground="#71809A"/>
                    </StackPanel>
                    <TextBlock x:Name="PositionText" Grid.Column="1" Foreground="#71809A" VerticalAlignment="Top"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Исходный текст (CN)" FontWeight="SemiBold"/>
                        <Button Content="⧉" HorizontalAlignment="Right" Width="28" Height="26" Background="Transparent" BorderThickness="0" ToolTip="Копировать Original" Click="CopyOriginal_Click"/>
                    </Grid>
                    <Border Background="#F7F9FC" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="92">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SelectedEntry.OriginalDisplay}" TextWrapping="Wrap" FontSize="16"/></ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Перевод (RU)" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CharacterCountText" HorizontalAlignment="Right" Foreground="#8190A7"/>
                    </Grid>
                    <Border x:Name="TranslationBorder" Background="White" BorderBrush="#7BA7F7" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="110">
                        <TextBox x:Name="TranslationBox"
                                 Text="{Binding SelectedEntry.Translation, Mode=TwoWay, UpdateSourceTrigger=Explicit, TargetNullValue=''}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="TranslationBox_TextChanged"
                                 LostKeyboardFocus="TranslationBox_LostKeyboardFocus"/>
                    </Border>
                </StackPanel>

                <Border Grid.Row="3" Margin="0,18,0,0" Background="#F8FAFD" BorderBrush="#E4E9F1" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Дополнительная информация" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Namespace" Foreground="#8190A7" Margin="0,3"/><TextBlock Grid.Column="1" Text="{Binding SelectedEntry.Namespace}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Text="Статус" Foreground="#8190A7" Margin="0,3"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEntry.StatusText}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Text="QA" Foreground="#8190A7" Margin="0,3"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEntry.QaStateText}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Text="Файл" Foreground="#8190A7" Margin="0,3"/><TextBlock x:Name="FileInfoText" Grid.Row="3" Grid.Column="1" Margin="0,3" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4" Margin="0,18,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="QA и структура" FontWeight="SemiBold"/>
                    <Border Grid.Row="1" Margin="0,8,0,0" Background="#FBFCFE" BorderBrush="#E4E9F1" BorderThickness="1" CornerRadius="8" Padding="12">
                        <TextBlock Text="{Binding SelectedEntry.ValidationSummary}" TextWrapping="Wrap" Foreground="#5F6F89"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource Card}">
            <Grid Margin="14">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Предпросмотр" FontWeight="SemiBold" Foreground="#2D70F5"/>
                    <TextBlock Text="    Связанные строки" Foreground="#73809A"/>
                </StackPanel>
                <Border Grid.Row="1" Margin="0,12,0,0" Background="#182337" CornerRadius="9">
                    <Grid>
                        <TextBlock Text="Предпросмотр из игры" Foreground="#DDE6F5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        <TextBlock Text="будет подключён на следующем этапе" Foreground="#91A1BB" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,34,0,0" FontSize="11"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" Text="Контекст" FontWeight="SemiBold" Margin="0,16,0,8"/>
                <StackPanel Grid.Row="3">
                    <Border Background="#F7F9FC" BorderBrush="#E4E9F1" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Технический контекст" FontWeight="SemiBold"/>
                            <TextBlock Text="Ключ, Namespace, QA и связанные данные будут собраны здесь без лишних кнопок." TextWrapping="Wrap" Foreground="#71809A" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Заметки" FontWeight="SemiBold" Margin="0,16,0,8"/>
                    <TextBox Height="120" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" Text="Заметки будут подключены после миграции основной редакторной логики." Foreground="#9AA6B9" Background="#FBFCFE" BorderBrush="#E4E9F1"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
