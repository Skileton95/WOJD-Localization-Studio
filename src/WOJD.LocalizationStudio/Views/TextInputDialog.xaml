<Window x:Class="WOJD.LocalizationStudio.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Margin="14"
            Background="White"
            BorderBrush="{StaticResource BorderBrushApp}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="6"
                              Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{StaticResource BackgroundBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Margin="18,0,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="×"
                        FontSize="20"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Click="Cancel_Click"/>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="24,22,24,0">
                <TextBlock x:Name="PromptText"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,0,10"/>
                <TextBox x:Name="ValueBox"
                         MinWidth="360"
                         Padding="10,8"
                         BorderBrush="{StaticResource BorderBrushApp}"
                         BorderThickness="1"
                         KeyDown="ValueBox_KeyDown"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,22,24,24">
                <Button Content="Отмена"
                        Width="110"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"
                        Margin="0,0,10,0"/>
                <Button Content="Перейти"
                        Width="120"
                        Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
