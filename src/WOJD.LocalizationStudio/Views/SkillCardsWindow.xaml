<Window x:Class="WOJD.LocalizationStudio.Views.SkillCardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточки навыков — WOJD Localization Studio"
        Width="1500" Height="900" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#0B1520" Foreground="#EAF2FA">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#101E2C"/>
        <SolidColorBrush x:Key="Panel2" Color="#142535"/>
        <SolidColorBrush x:Key="Line" Color="#263B4D"/>
        <SolidColorBrush x:Key="Accent" Color="#2F8CFF"/>
        <SolidColorBrush x:Key="Muted" Color="#91A6B9"/>

        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF2FA"/>
            <Setter Property="Background" Value="#172838"/>
            <Setter Property="BorderBrush" Value="#30475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#136CC2"/>
            <Setter Property="BorderBrush" Value="#3294F0"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F3F7FB"/>
            <Setter Property="Background" Value="#0E1924"/>
            <Setter Property="BorderBrush" Value="#30475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="SkillItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="#0E1B27" BorderBrush="#22384A" BorderThickness="1" CornerRadius="8" Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#172B3D"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="#174A76"/><Setter TargetName="Root" Property="BorderBrush" Value="#2F8CFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EntryItem" TargetType="ListBoxItem" BasedOn="{StaticResource SkillItem}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D1924" BorderBrush="#23394A" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#174A76" Margin="0,0,10,0">
                        <TextBlock Text="技" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Карточки навыков" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Все ключи навыка в одном месте" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
                <TextBox x:Name="SkillSearchBox" Grid.Column="2" Style="{StaticResource DarkTextBox}" VerticalAlignment="Center"
                         TextChanged="SkillSearchBox_TextChanged" ToolTip="Поиск по названию или ID навыка"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋ Добавить связь" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="AddLink_Click"/>
                    <Button Content="− Удалить связь" Style="{StaticResource DarkButton}" Margin="0,0,8,0" Click="RemoveLink_Click"/>
                    <Button Content="↗ Открыть в файле" Style="{StaticResource DarkButton}" Click="OpenInFile_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="275"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Навыки" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="⟳" Style="{StaticResource DarkButton}" Padding="8,4" Click="RefreshCards_Click" ToolTip="Пересобрать карточки"/>
                        <TextBlock x:Name="SkillCountText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="SkillList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SkillItem}" SelectionChanged="SkillList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="7" Background="#173A59" VerticalAlignment="Center">
                                        <TextBlock Text="✦" Foreground="#58B7FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ID: " Foreground="{StaticResource Muted}" FontSize="11"/>
                                            <TextBlock Text="{Binding Id}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                            <TextBlock Text="  ·  " Foreground="{StaticResource Muted}" FontSize="11"/>
                                            <TextBlock Text="{Binding LinkedCount}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                            <TextBlock Text=" ключей" Foreground="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource Panel}" BorderBrush="#2B4E69" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SkillTitleText" Text="Выберите навык" FontSize="26" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="ID: " Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="SkillIdText" FontWeight="SemiBold"/>
                                <TextBlock Text="    Уникальных: " Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="UniqueCountText"/>
                                <TextBlock Text="    Общих: " Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="SharedCountText"/>
                            </StackPanel>
                            <TextBlock x:Name="SkillDescriptionText" Foreground="{StaticResource Muted}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#173A59" CornerRadius="16" Padding="13,7" VerticalAlignment="Top">
                            <TextBlock x:Name="LinkedCountText" Text="0 связанных ключей"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="2,0,2,10">
                            <TextBlock Text="Связанные ключи" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="EntryCountText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                        </DockPanel>
                        <ListBox x:Name="EntryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource EntryItem}" SelectionChanged="EntryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Role}" FontWeight="SemiBold"/>
                                            <Border HorizontalAlignment="Left" Margin="0,4,0,0" CornerRadius="9" Padding="7,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#4B2B75"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsShared}" Value="True"><Setter Property="Background" Value="#174A76"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding LinkTypeShort}" FontSize="10"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="{Binding Entry.Key}" Foreground="#C8D8E6"/>
                                            <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Padding="8,3">
                                            <Border.Style>
                                                <Style TargetType="Border"><Setter Property="Background" Value="#174F39"/><Style.Triggers><DataTrigger Binding="{Binding Entry.HasValidationIssues}" Value="True"><Setter Property="Background" Value="#6C4D14"/></DataTrigger></Style.Triggers></Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding QaText}" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Строка карточки" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RoleText" Text="Выберите связанную строку" Foreground="#58B7FF" FontSize="14" Margin="0,4,0,14"/>

                        <TextBlock Text="Тип связи" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBlock x:Name="LinkTypeText" Margin="0,3,0,12"/>

                        <TextBlock Text="Namespace" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBox x:Name="NamespaceBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Margin="0,3,0,10"/>

                        <TextBlock Text="Ключ" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBox x:Name="KeyBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Margin="0,3,0,10"/>

                        <TextBlock Text="Оригинал (CN)" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBox x:Name="OriginalBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" Margin="0,3,0,10"/>

                        <TextBlock Text="Перевод (RU)" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBox x:Name="TranslationBox" Style="{StaticResource DarkTextBox}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="140" Margin="0,3,0,10"
                                 TextChanged="TranslationBox_TextChanged"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="QA" Foreground="{StaticResource Muted}" FontSize="11"/>
                                <TextBlock x:Name="QaText" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="CharacterCountText" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom"/>
                        </Grid>

                        <Separator Background="#263B4D" Margin="0,4,0,12"/>
                        <TextBlock Text="Как работает карточка" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Уникальные ключи собираются по ID навыка. Общие ключи показываются как ссылки на реальные строки файла. Изменение перевода здесь изменяет ту же строку NDJSON — копии не создаются."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0D1924" BorderBrush="#23394A" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="0.1.27 · Skill Context View" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
