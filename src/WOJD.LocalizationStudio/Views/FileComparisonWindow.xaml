<Window x:Class="WOJD.LocalizationStudio.Views.FileComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение файлов"
        Width="1320"
        Height="760"
        MinWidth="1000"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="4,0,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Сравнение версий"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtitleText"
                           Margin="0,5,0,0"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Закрыть"
                    Style="{StaticResource SecondaryButton}"
                    Padding="16,8"
                    Click="Close_Click"/>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SummaryText"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="WarningText"
                               Margin="0,5,0,0"
                               Foreground="#D94C4C"/>
                </StackPanel>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Padding="8,6"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <DataGrid ItemsSource="{Binding ItemsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      BorderThickness="0"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding ChangeType}"
                                        Width="210"/>
                    <DataGridTextColumn Header="Namespace"
                                        Binding="{Binding Namespace}"
                                        Width="210"/>
                    <DataGridTextColumn Header="Ключ"
                                        Binding="{Binding Key}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Старый оригинал"
                                        Binding="{Binding OldOriginal}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Новый оригинал"
                                        Binding="{Binding NewOriginal}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Старый перевод"
                                        Binding="{Binding OldTranslation}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Новый перевод"
                                        Binding="{Binding NewTranslation}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Автоперенос заполняет только пустой перевод при неизменённом оригинале. Существующий перевод никогда не перезаписывается."
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,16,0"/>
            <Button Grid.Column="1"
                    Content="Перенести безопасные"
                    Style="{StaticResource PrimaryButton}"
                    Padding="18,9"
                    Click="Transfer_Click"/>
        </Grid>
    </Grid>
</Window>
