<Window x:Class="WOJD.LocalizationStudio.Views.ExternalFileChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Margin="14"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushApp}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="6"
                              Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{StaticResource BackgroundBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Файл изменён извне"
                           Margin="18,0,0,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="×"
                        FontSize="20"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Click="Cancel_Click"/>
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="24,22,24,0">
                <TextBlock x:Name="MessageText"
                           FontSize="15"
                           TextWrapping="Wrap"
                           LineHeight="22"/>
                <TextBlock Text="Выберите, какую версию оставить. «Сравнить» ничего не записывает и открывает различия."
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,24,24,24">
                <Button Content="Перезагрузить"
                        Width="125"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="Reload_Click"/>
                <Button Content="Сравнить"
                        Width="110"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Click="Compare_Click"/>
                <Button Content="Оставить мою"
                        Width="130"
                        Style="{StaticResource PrimaryButton}"
                        Click="KeepMine_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
