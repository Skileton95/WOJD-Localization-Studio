<Window x:Class="WOJD.LocalizationStudio.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Margin="14"
            Background="White"
            BorderBrush="{StaticResource BorderBrushApp}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="6"
                              Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{StaticResource BackgroundBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="48"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="8"
                            Background="{StaticResource AccentSoftBrush}"
                            Margin="0,0,10,0">
                        <TextBlock Text="译"
                                   FontSize="16"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="WOJD Localization Studio"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="×"
                        FontSize="20"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource MutedTextBrush}"
                        Cursor="Hand"
                        Click="Close_Click"/>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="24,24,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="40"
                        Height="40"
                        CornerRadius="11"
                        Background="{StaticResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="↓"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0">
                    <TextBlock Text="Доступно обновление"
                               FontSize="22"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Доступна новая версия WOJD Localization Studio."
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <Border Margin="0,14,0,0"
                            Padding="12,9"
                            CornerRadius="8"
                            Background="{StaticResource AccentSoftBrush}"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="VersionTextBlock"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>

                    <TextBlock Margin="0,16,0,0"
                               Text="После нажатия «Обновиться» прогресс загрузки появится в нижней части главного окна. После установки программа перезапустится автоматически."
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,24,24,24">
                <Button Content="Позже"
                        Width="112"
                        Style="{StaticResource SecondaryButton}"
                        Click="Later_Click"
                        Margin="0,0,10,0"/>
                <Button Content="Обновиться"
                        Width="132"
                        Style="{StaticResource PrimaryButton}"
                        Click="Update_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
