<UserControl x:Class="WOJD.LocalizationStudio.Views.EditorWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="170">
    <Border Background="White"
            BorderBrush="{StaticResource BorderBrushApp}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="ExternalChangeBanner"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#FFF8E8"
                    BorderBrush="#E7B64A"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ExternalChangeText"
                               Text="Файл изменён другой программой."
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="Сравнить" Click="ExternalCompare_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="8,0,6,0"/>
                    <Button Grid.Column="2" Content="Перезагрузить" Click="ExternalReload_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0"/>
                    <Button Grid.Column="3" Content="Сохранить поверх" Click="ExternalOverwrite_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0"/>
                    <Button Grid.Column="4" Content="Игнорировать" Click="ExternalIgnore_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedEntry.Namespace, Mode=OneWay}"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="  ·  " Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding SelectedEntry.Key, Mode=OneWay}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="История" Click="History_Click" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="6,0,0,0"/>
                    <Button Content="Снимки" Click="Snapshots_Click" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="6,0,0,0"/>
                    <Button Content="Consistency" Click="Consistency_Click" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="6,0,0,0"/>
                    <Button Content="Глоссарий" Click="Glossary_Click" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="6,0,0,0"/>
                    <Button Content="Настройки" Click="Settings_Click" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="6,0,0,0"/>
                    <Button x:Name="CollapseButton" Content="Свернуть" Click="Collapse_Click" Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="6,0,0,0"/>
                </WrapPanel>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Оригинал" FontWeight="SemiBold" FontSize="15"/>
                    <Border Grid.Row="1" Margin="0,7,0,0" Background="#FAFBFD"
                            BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1"
                            CornerRadius="7" Padding="11">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding SelectedEntry.OriginalDisplay, Mode=OneWay}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Background="{StaticResource BorderBrushApp}"/>

                <Grid Grid.Column="2" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Перевод" FontWeight="SemiBold" FontSize="15"/>
                    <Border Grid.Row="1" Margin="0,7,0,0" Background="White"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="10">
                        <TextBox x:Name="TranslationBox"
                                 Text="{Binding SelectedEntry.Translation, Mode=TwoWay, UpdateSourceTrigger=Explicit, TargetNullValue=''}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 TextChanged="TranslationBox_TextChanged"
                                 LostKeyboardFocus="TranslationBox_LostKeyboardFocus"
                                 PreviewKeyDown="TranslationBox_PreviewKeyDown"/>
                    </Border>
                    <Border x:Name="TokenPreviewBorder"
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            Background="#FAFBFD"
                            BorderBrush="{StaticResource BorderBrushApp}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6"
                            Height="58">
                        <RichTextBox x:Name="TokenPreview"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"
                                     IsDocumentEnabled="False"/>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="QaDetailsBorder"
                    Grid.Row="3"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrushApp}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,6"
                    Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StructureSummaryText"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="StructureDetailsText"
                               Grid.Column="1"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="4" Margin="0,8,0,0" VerticalAlignment="Center">
                <Button Content="↺ Структура" Click="RestoreStructure_Click"
                        Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,6,0"/>
                <CheckBox x:Name="ProtectStructureCheckBox" Content="Защита" IsChecked="True"
                          VerticalAlignment="Center" Margin="2,0,12,0"/>
                <Button Content="Автоисправить" Click="AutoCorrect_Click"
                        Style="{StaticResource PrimaryButton}" Padding="11,6" Margin="0,0,6,0"/>
                <Button Content="Массово…" Click="BulkAutoCorrect_Click"
                        Style="{StaticResource SecondaryButton}" Padding="11,6" Margin="0,0,12,0"/>
                <Button Content="ИИ: строка" Click="AiCurrent_Click"
                        Style="{StaticResource SecondaryButton}" Padding="11,6" Margin="0,0,6,0"/>
                <Button Content="ИИ: пакет…" Click="AiBatch_Click"
                        Style="{StaticResource SecondaryButton}" Padding="11,6" Margin="0,0,12,0"/>
                <TextBlock Text="Проверка:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="ReviewStatusCombo" Width="145" Height="30"
                          SelectionChanged="ReviewStatusCombo_SelectionChanged" Margin="0,0,6,0"/>
                <Button Content="✓ и дальше" Click="ReviewedNext_Click"
                        Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="0,0,6,0"/>
                <Button Content="⚠ и дальше" Click="NeedsFixNext_Click"
                        Style="{StaticResource SecondaryButton}" Padding="9,5"/>
            </WrapPanel>

            <Expander x:Name="AssistantExpander"
                      Grid.Row="5"
                      Header="Помощник: Translation Memory и глоссарий"
                      IsExpanded="False"
                      Margin="0,7,0,0">
                <TabControl Height="142" Margin="0,5,0,0">
                    <TabItem Header="Translation Memory">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="TmList" MouseDoubleClick="TmList_MouseDoubleClick" DisplayMemberPath="Display"/>
                            <Button Grid.Column="1" Content="Применить"
                                    Click="ApplyTm_Click" Style="{StaticResource SecondaryButton}"
                                    Padding="10,6" Margin="8,0,0,0" VerticalAlignment="Top"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Глоссарий">
                        <ListBox x:Name="GlossaryMatchesList" Margin="6" DisplayMemberPath="Display"/>
                    </TabItem>
                </TabControl>
            </Expander>

            <Grid x:Name="OperationPanel" Grid.Row="6" Visibility="Collapsed" Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OperationText" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ProgressBar x:Name="OperationProgress" Grid.Column="1" Height="7" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Отмена" Click="CancelOperation_Click"
                        Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="10,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
