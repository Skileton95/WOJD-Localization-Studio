<UserControl x:Class="WOJD.LocalizationStudio.Views.EditorWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="170">
    <Border Background="White"
            BorderBrush="{StaticResource BorderBrushApp}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="ExternalChangeBanner"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#FFF8E8"
                    BorderBrush="#E7B64A"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ExternalChangeText"
                               Text="Файл изменён другой программой."
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Content="Сравнить" Click="ExternalCompare_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="8,0,6,0"/>
                    <Button Grid.Column="2" Content="Перезагрузить" Click="ExternalReload_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0"/>
                    <Button Grid.Column="3" Content="Сохранить поверх" Click="ExternalOverwrite_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0"/>
                    <Button Grid.Column="4" Content="Игнорировать" Click="ExternalIgnore_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FileNameText"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="UnsavedIndicator"
                                   Text="  •"
                                   Foreground="#F3A51B"
                                   FontWeight="Bold"
                                   Visibility="Collapsed"
                                   ToolTip="Есть несохранённые изменения"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="EntryMetaText"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12"/>
                        <Button Content="⧉"
                                Click="CopyKey_Click"
                                Width="24" Height="22" Padding="0" Margin="6,-2,0,0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource MutedTextBrush}"
                                ToolTip="Копировать ключ"/>
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="◷" Click="History_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0"
                            MinWidth="34" ToolTip="История строки"/>
                    <Button Content="Согласованность" Click="Consistency_Click"
                            Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="6,0,0,0"
                            ToolTip="Найти разные переводы одинакового Original"/>
                    <Button x:Name="FocusModeButton" Content="⛶" Click="FocusMode_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0"
                            MinWidth="34" ToolTip="Режим фокус"/>
                    <Button x:Name="MoreButton" Content="⋯" Click="More_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0"
                            MinWidth="34" ToolTip="Дополнительные действия">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Копировать Original" Click="CopyOriginal_Click"/>
                                <MenuItem Header="Копировать перевод" Click="CopyTranslation_Click"/>
                                <MenuItem Header="Копировать ключ" Click="CopyKey_Click"/>
                                <MenuItem Header="Очистить перевод" Click="ClearTranslation_Click"/>
                                <MenuItem Header="Экспортировать строку…" Click="ExportCurrent_Click"/>
                                <Separator/>
                                <MenuItem Header="Горизонтальный редактор" Click="HorizontalLayout_Click"/>
                                <MenuItem Header="Вертикальный редактор" Click="VerticalLayout_Click"/>
                                <MenuItem Header="Только перевод" Click="TranslationOnly_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="CollapseButton" Content="⌃" Click="Collapse_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0"
                            MinWidth="34" ToolTip="Свернуть редактор"/>
                </WrapPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="#FCFDFE"
                    BorderBrush="{StaticResource BorderBrushApp}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid x:Name="EditorPanesGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PaneColumn1" Width="*"/>
                        <ColumnDefinition x:Name="PaneColumnDivider" Width="1"/>
                        <ColumnDefinition x:Name="PaneColumn2" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PaneRow1" Height="*"/>
                        <RowDefinition x:Name="PaneRowDivider" Height="0"/>
                        <RowDefinition x:Name="PaneRow2" Height="0"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="OriginalPane" Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid MouseLeftButtonDown="OriginalHeader_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Оригинал" FontWeight="SemiBold" FontSize="15"/>
                            <Button Grid.Column="1" Content="⧉" Click="CopyOriginal_Click"
                                    Width="26" Height="22" Padding="0" Margin="6,-2,0,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    ToolTip="Копировать Original"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" Margin="0,7,0,0" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding SelectedEntry.OriginalDisplay, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       Padding="4,3"/>
                        </ScrollViewer>
                    </Grid>

                    <Border x:Name="PaneDivider" Grid.Column="1" Background="{StaticResource BorderBrushApp}"/>

                    <Grid x:Name="TranslationPane" Grid.Column="2" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid MouseLeftButtonDown="TranslationHeader_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Перевод" FontWeight="SemiBold" FontSize="15"/>
                            <Button Grid.Column="1" Content="⧉" Click="CopyTranslation_Click"
                                    Width="26" Height="22" Padding="0" Margin="6,-2,0,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    ToolTip="Копировать перевод"/>
                        </Grid>
                        <Border x:Name="TranslationEditorBorder"
                                Grid.Row="1" Margin="0,7,0,0" Background="White"
                                BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1"
                                CornerRadius="7" Padding="10">
                            <TextBox x:Name="TranslationBox"
                                     Text="{Binding SelectedEntry.Translation, Mode=TwoWay, UpdateSourceTrigger=Explicit, TargetNullValue=''}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     TextChanged="TranslationBox_TextChanged"
                                     GotKeyboardFocus="TranslationBox_GotKeyboardFocus"
                                     LostKeyboardFocus="TranslationBox_LostKeyboardFocus"
                                     PreviewKeyDown="TranslationBox_PreviewKeyDown"/>
                        </Border>
                        <Border x:Name="TokenPreviewBorder"
                                Grid.Row="2"
                                Margin="0,6,0,0"
                                Background="#FAFBFD"
                                BorderBrush="{StaticResource BorderBrushApp}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6"
                                Height="58">
                            <RichTextBox x:Name="TokenPreview"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalScrollBarVisibility="Auto"
                                         IsDocumentEnabled="False"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="QaDetailsBorder"
                    Grid.Row="3"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource BorderBrushApp}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="7,5"
                    Margin="0,8,0,0">
                <WrapPanel VerticalAlignment="Center">
                    <Border x:Name="TagsChip" Background="#EEF9F2" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock x:Name="TagsChipText" Foreground="#238A50" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="PlaceholdersChip" Background="#EEF9F2" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock x:Name="PlaceholdersChipText" Foreground="#238A50" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="NewLinesChip" Background="#EEF9F2" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock x:Name="NewLinesChipText" Foreground="#238A50" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="StructureChip" Background="#F1F4F8" CornerRadius="10" Padding="8,3">
                        <TextBlock x:Name="StructureChipText" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                    </Border>
                </WrapPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Button x:Name="RestoreStructureButton"
                            Content="↺ Структура" Click="RestoreStructure_Click"
                            Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,6,0"
                            Visibility="Collapsed"
                            ToolTip="Восстановить однозначно повреждённые теги и плейсхолдеры по Original"/>
                    <Button x:Name="AutoCorrectButton"
                            Content="Автоисправить" Click="AutoCorrect_Click"
                            Style="{StaticResource PrimaryButton}" Padding="11,6" Margin="0,0,6,0"
                            ToolTip="Безопасное автоисправление текущей строки"/>
                    <Button x:Name="BulkAutoCorrectButton"
                            Content="Автоисправление файла…" Click="BulkAutoCorrect_Click"
                            Style="{StaticResource SecondaryButton}" Padding="11,6"
                            ToolTip="Проверить и исправить только текущий активный файл"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹" Command="{Binding PreviousCommand}"
                            Style="{StaticResource SecondaryButton}" Width="34" Height="30" Padding="0"/>
                    <TextBlock x:Name="PositionText"
                               Margin="10,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <Button Content="›" Command="{Binding NextCommand}"
                            Style="{StaticResource SecondaryButton}" Width="34" Height="30" Padding="0"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="OperationPanel" Grid.Row="5" Visibility="Collapsed" Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OperationText" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ProgressBar x:Name="OperationProgress" Grid.Column="1" Height="7" Minimum="0" Maximum="100" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Отмена" Click="CancelOperation_Click"
                        Style="{StaticResource SecondaryButton}" Padding="9,5" Margin="10,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
