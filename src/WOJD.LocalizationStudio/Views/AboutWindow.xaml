<Window x:Class="WOJD.LocalizationStudio.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="620"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="WOJD Localization Studio"
                       FontSize="26"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText"
                       Margin="0,5,0,14"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock TextWrapping="Wrap"
                       LineHeight="22">
                <Run Text="Редактор русификатора World of Jade Dynasty / Zhu Xian World."/>
                <LineBreak/><LineBreak/>
                <Run Text="Поддерживаемые форматы:" FontWeight="SemiBold"/>
                <LineBreak/>
                <Run Text="• NDJSON / JSONL"/>
                <LineBreak/>
                <Run Text="• Unreal Engine LOCRES"/>
                <LineBreak/><LineBreak/>
                <Run Text="Проектный режим:" FontWeight="SemiBold"/>
                <LineBreak/>
                <Run Text="Профиль .wojdproject.json, локальный SQLite-индекс, глоссарий, заметки, QA, история, review queue, Git, синхронизация и release-пакеты."/>
                <LineBreak/><LineBreak/>
                <Run Text="Данные проекта хранятся локально в .wojd-studio и не записываются в игровые строки."/>
            </TextBlock>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Закрыть"
                Style="{StaticResource PrimaryButton}"
                Padding="18,8"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                Click="Close_Click"/>
    </Grid>
</Window>
