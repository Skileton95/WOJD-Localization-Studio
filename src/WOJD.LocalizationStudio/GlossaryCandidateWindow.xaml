<Window x:Class="WOJD.LocalizationStudio.GlossaryCandidateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кандидаты в глоссарий"
        Width="1100"
        Height="680"
        MinWidth="850"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#EEF4FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Кандидаты в глоссарий"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#172A3B"/>
            <TextBlock x:Name="SummaryText"
                       Foreground="#687A8B"
                       Margin="0,5,0,12"
                       Text="Повторяющиеся китайские слова и фразы, которых ещё нет в глоссарии."/>
        </StackPanel>

        <DataGrid x:Name="CandidateGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  MouseDoubleClick="CandidateGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Кандидат" Binding="{Binding Source}" Width="150"/>
                <DataGridTextColumn Header="Вхождений" Binding="{Binding Occurrences}" Width="85"/>
                <DataGridTextColumn Header="Вариантов точного перевода" Binding="{Binding TranslationVariantCount}" Width="145"/>
                <DataGridTextColumn Header="Точные варианты" Binding="{Binding TranslationVariants}" Width="1.1*"/>
                <DataGridTextColumn Header="Примеры строк" Binding="{Binding Examples}" Width="1.6*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Выберите кандидата, чтобы перенести его в форму нового термина."
                       Foreground="#687A8B"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Закрыть"
                        Width="90"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Добавить выбранный"
                        Width="145"
                        Background="#2F7BEA"
                        Foreground="White"
                        BorderBrush="#266ACB"
                        Click="AddButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
