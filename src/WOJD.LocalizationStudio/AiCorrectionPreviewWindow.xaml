<Window x:Class="WOJD.LocalizationStudio.AiCorrectionPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предпросмотр исправления"
        Width="820"
        Height="620"
        MinWidth="680"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Умное исправление ChatGPT"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1C2E3E"/>
            <TextBlock x:Name="SourceText"
                       Margin="0,6,0,14"
                       Foreground="#687A8B"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Было" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Стало" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="BeforeTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10"/>

            <TextBox x:Name="AfterTextBox"
                     Grid.Column="2"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#526579"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Отмена"
                        Width="90"
                        Margin="10,0,8,0"
                        IsCancel="True"/>
                <Button Content="Применить"
                        Width="110"
                        Background="#2F7BEA"
                        Foreground="White"
                        BorderBrush="#266ACB"
                        IsDefault="True"
                        Click="ApplyButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
