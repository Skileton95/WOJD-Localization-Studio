<Window x:Class="WOJD.LocalizationStudio.OpenAiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT / OpenAI API"
        Width="470"
        Height="250"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="API-ключ OpenAI"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#1C2E3E"/>

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,10"
                   Text="Ключ нужен только для умного исправления через ChatGPT. Не публикуйте и не отправляйте его другим пользователям."
                   Foreground="#667789"
                   TextWrapping="Wrap"/>

        <PasswordBox x:Name="ApiKeyBox"
                     Grid.Row="2"
                     Height="38"
                     Padding="9,7"
                     VerticalContentAlignment="Center"/>

        <CheckBox x:Name="RememberCheckBox"
                  Grid.Row="3"
                  Margin="0,10,0,0"
                  Content="Запомнить на этом компьютере"
                  IsChecked="True"
                  Foreground="#43586B"
                  VerticalAlignment="Top"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Отмена"
                    Width="90"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Сохранить"
                    Width="100"
                    Background="#2F7BEA"
                    Foreground="White"
                    BorderBrush="#266ACB"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
