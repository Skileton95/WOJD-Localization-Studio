<Window x:Class="WOJD.LocalizationStudio.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Глоссарий"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#EEF4FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Глоссарий"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#172A3B"/>
                <TextBlock x:Name="GlossarySummaryText"
                           Text="Терминов: 0"
                           Foreground="#687A8B"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Импорт JSON" Click="ImportButton_Click"/>
                <Button Content="Экспорт JSON" Click="ExportButton_Click"/>
                <Button Content="+ Новый термин"
                        Click="NewButton_Click"
                        Background="#2F7BEA"
                        Foreground="White"
                        BorderBrush="#266ACB"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Background="#F9FBFD"
                    BorderBrush="#D3DEE8"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox"
                             Height="38"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Поиск по китайскому термину, переводу или заметке"/>

                    <DataGrid x:Name="GlossaryGrid"
                              Grid.Row="1"
                              Margin="0,10,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="GlossaryGrid_SelectionChanged"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Китайский термин"
                                                Binding="{Binding Source}"
                                                Width="1.2*"/>
                            <DataGridTextColumn Header="Русский перевод"
                                                Binding="{Binding Translation}"
                                                Width="1.3*"/>
                            <DataGridTextColumn Header="Режим"
                                                Binding="{Binding LockText}"
                                                Width="95"/>
                            <DataGridTextColumn Header="Заметка"
                                                Binding="{Binding Note}"
                                                Width="1.0*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#F9FBFD"
                    BorderBrush="#D3DEE8"
                    BorderThickness="1"
                    CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock x:Name="EditorTitle"
                                   Text="Новый термин"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#172A3B"/>

                        <TextBlock Text="Китайский термин"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,6"/>
                        <TextBox x:Name="SourceBox"
                                 Height="72"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Русский перевод"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,6"/>
                        <TextBox x:Name="TranslationBox"
                                 Height="72"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <CheckBox x:Name="LockedCheckBox"
                                  Content="Закреплённый перевод"
                                  IsChecked="True"
                                  Margin="0,14,0,0"
                                  ToolTip="Для закреплённого термина редактор предупреждает, если в переводе используется другой вариант"/>

                        <TextBlock Text="Заметка"
                                   FontWeight="SemiBold"
                                   Margin="0,16,0,6"/>
                        <TextBox x:Name="NoteBox"
                                 Height="100"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Button Content="Сохранить термин"
                                Click="SaveButton_Click"
                                Background="#2F7BEA"
                                Foreground="White"
                                BorderBrush="#266ACB"
                                Margin="0,18,0,0"/>

                        <Button x:Name="DeleteButton"
                                Content="Удалить термин"
                                Click="DeleteButton_Click"
                                Foreground="#B33A2B"
                                Margin="0,8,0,0"
                                IsEnabled="False"/>

                        <TextBlock Text="Закреплённый термин используется редактором как обязательная терминология. Режим «Подсказка» показывает совпадение, но не считает другой перевод ошибкой."
                                   Foreground="#6B7D8E"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text=""
                   Foreground="#687A8B"
                   Margin="2,10,0,0"/>
    </Grid>
</Window>
