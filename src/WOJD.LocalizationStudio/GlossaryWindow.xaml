<Window x:Class="WOJD.LocalizationStudio.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Глоссарий"
        Width="1320"
        Height="780"
        MinWidth="1040"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#EEF4FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Глоссарий"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#172A3B"/>
                <TextBlock x:Name="GlossarySummaryText"
                           Text="Терминов: 0"
                           Foreground="#687A8B"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Кандидаты"
                        Click="CandidatesButton_Click"/>
                <Button Content="Конфликты"
                        Margin="8,0,0,0"
                        Click="ConflictsButton_Click"/>
                <Button Content="Импорт JSON"
                        Margin="8,0,0,0"
                        Click="ImportButton_Click"/>
                <Button Content="Экспорт JSON"
                        Margin="8,0,0,0"
                        Click="ExportButton_Click"/>
                <Button Content="+ Новый термин"
                        Click="NewButton_Click"
                        Background="#2F7BEA"
                        Foreground="White"
                        BorderBrush="#266ACB"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <Border Background="#F9FBFD"
                    BorderBrush="#D3DEE8"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox"
                             Height="38"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="Поиск по термину, переводу, допустимым формам, Namespace или заметке"/>

                    <DataGrid x:Name="GlossaryGrid"
                              Grid.Row="1"
                              Margin="0,10,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="GlossaryGrid_SelectionChanged"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Китайский термин"
                                                Binding="{Binding Source}"
                                                Width="1.0*"/>
                            <DataGridTextColumn Header="Русский перевод"
                                                Binding="{Binding Translation}"
                                                Width="1.0*"/>
                            <DataGridTextColumn Header="Допустимые формы"
                                                Binding="{Binding AllowedText}"
                                                Width="1.0*"/>
                            <DataGridTextColumn Header="Namespace"
                                                Binding="{Binding ScopeText}"
                                                Width="1.0*"/>
                            <DataGridTextColumn Header="Приоритет"
                                                Binding="{Binding Priority}"
                                                Width="75"/>
                            <DataGridTextColumn Header="Режим"
                                                Binding="{Binding LockText}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#F9FBFD"
                    BorderBrush="#D3DEE8"
                    BorderThickness="1"
                    CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock x:Name="EditorTitle"
                                   Text="Новый термин"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#172A3B"/>

                        <TextBlock Text="Китайский термин"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,6"/>
                        <TextBox x:Name="SourceBox"
                                 Height="58"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>

                        <TextBlock Text="Основной русский перевод"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,6"/>
                        <TextBox x:Name="TranslationBox"
                                 Height="58"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>

                        <TextBlock Text="Допустимые формы"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,6"/>
                        <TextBox x:Name="AllowedTranslationsBox"
                                 Height="72"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="По одной допустимой форме на строку. Основной перевод добавлять не нужно."/>
                        <TextBlock Text="Например: «духовной силы», «духовную силу». Эти формы не считаются нарушением."
                                   Foreground="#6B7D8E"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="Область Namespace"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,6"/>
                        <TextBox x:Name="NamespaceScopesBox"
                                 Height="66"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Пусто = термин действует везде. Иначе по одному Namespace на строку."/>
                        <TextBlock Text="Пустое поле = Везде. Можно указать несколько Namespace."
                                   Foreground="#6B7D8E"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="LockedCheckBox"
                                      Content="Закреплённый перевод"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Приоритет"
                                           FontWeight="SemiBold"
                                           FontSize="11"/>
                                <TextBox x:Name="PriorityBox"
                                         Text="0"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Больший приоритет выигрывает при пересечении терминов"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Заметка"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,6"/>
                        <TextBox x:Name="NoteBox"
                                 Height="74"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Button x:Name="WhereUsedButton"
                                Content="Где используется"
                                Click="WhereUsedButton_Click"
                                IsEnabled="False"
                                Margin="0,16,0,0"/>

                        <Button Content="Сохранить термин"
                                Click="SaveButton_Click"
                                Background="#2F7BEA"
                                Foreground="White"
                                BorderBrush="#266ACB"
                                Margin="0,8,0,0"/>

                        <Button x:Name="DeleteButton"
                                Content="Удалить термин"
                                Click="DeleteButton_Click"
                                Foreground="#B33A2B"
                                Margin="0,8,0,0"
                                IsEnabled="False"/>

                        <TextBlock Text="При пересечении терминов сначала используется больший приоритет, затем более длинный китайский термин. Закреплённый термин допускает основной перевод и перечисленные формы."
                                   Foreground="#6B7D8E"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text=""
                   Foreground="#687A8B"
                   Margin="2,10,0,0"/>
    </Grid>
</Window>
