<Window x:Class="WOJD.LocalizationStudio.TranslationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История изменений"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="История строки"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1C2E3E"/>
            <TextBlock x:Name="SubtitleText"
                       Margin="0,4,0,12"
                       Foreground="#687A8B"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid x:Name="HistoryGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время" Binding="{Binding LocalTimestamp}" Width="145"/>
                <DataGridTextColumn Header="Оригинал" Binding="{Binding Source}" Width="1.2*"/>

                <DataGridTemplateColumn Header="Было" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="4,2">
                                <Run Text="{Binding CommonPrefix}"/>
                                <Run Text="{Binding BeforeChanged}"
                                     Foreground="#B33A2B"
                                     FontWeight="Bold"/>
                                <Run Text="{Binding CommonSuffix}"/>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Стало" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="4,2">
                                <Run Text="{Binding CommonPrefix}"/>
                                <Run Text="{Binding AfterChanged}"
                                     Foreground="#267540"
                                     FontWeight="Bold"/>
                                <Run Text="{Binding CommonSuffix}"/>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Закрыть"
                Width="100"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                IsCancel="True"/>
    </Grid>
</Window>
