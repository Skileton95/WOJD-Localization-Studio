<Window x:Class="WOJD.LocalizationStudio.SimilarityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Похожие строки и память переводов"
        Width="1050"
        Height="680"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#EEF4FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Память переводов"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#172A3B"/>
            <TextBlock x:Name="CurrentText"
                       Foreground="#687A8B"
                       Margin="0,5,0,12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Похожие оригиналы">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="SourceMatchesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              MouseDoubleClick="SourceMatchesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Совпадение" Binding="{Binding PercentText}" Width="90"/>
                            <DataGridTextColumn Header="Источник" Binding="{Binding OriginText}" Width="90"/>
                            <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="140"/>
                            <DataGridTextColumn Header="Оригинал" Binding="{Binding Source}" Width="1.2*"/>
                            <DataGridTextColumn Header="Перевод" Binding="{Binding Translation}" Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1"
                            Content="Использовать выбранный перевод"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0"
                            Click="UseSourceMatchButton_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Похожие русские формулировки">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="TranslationMatchesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Совпадение" Binding="{Binding PercentText}" Width="90"/>
                            <DataGridTextColumn Header="Источник" Binding="{Binding OriginText}" Width="90"/>
                            <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="140"/>
                            <DataGridTextColumn Header="Оригинал" Binding="{Binding Source}" Width="1.2*"/>
                            <DataGridTextColumn Header="Перевод" Binding="{Binding Translation}" Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2"
                Content="Закрыть"
                Width="100"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                IsCancel="True"/>
    </Grid>
</Window>
