<Window x:Class="WOJD.LocalizationStudio.GlossaryConsistencyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Единообразие терминологии"
        Width="1050"
        Height="650"
        MinWidth="820"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#EEF4FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Единообразие терминологии"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#172A3B"/>
            <TextBlock x:Name="SummaryText"
                       Foreground="#687A8B"
                       Margin="0,5,0,12"/>
        </StackPanel>

        <DataGrid x:Name="ConsistencyGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MismatchOccurrences}" Value="0">
                            <Setter Property="Background" Value="#F5FBF6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Китайский термин" Binding="{Binding Source}" Width="1.0*"/>
                <DataGridTextColumn Header="Закреплённый перевод" Binding="{Binding ExpectedTranslation}" Width="1.2*"/>
                <DataGridTextColumn Header="Всего" Binding="{Binding TotalOccurrences}" Width="70"/>
                <DataGridTextColumn Header="Верно" Binding="{Binding CorrectOccurrences}" Width="70"/>
                <DataGridTextColumn Header="Нарушений" Binding="{Binding MismatchOccurrences}" Width="85"/>
                <DataGridTextColumn Header="Покрытие" Binding="{Binding CoverageText}" Width="85"/>
                <DataGridTextColumn Header="Примеры нарушений" Binding="{Binding Samples}" Width="1.6*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Закрыть"
                Width="100"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                IsCancel="True"/>
    </Grid>
</Window>
