<Window x:Class="WOJD.LocalizationStudio.GlossaryConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конфликты глоссария"
        Width="1000"
        Height="620"
        MinWidth="800"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#EEF4FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Конфликты глоссария"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#172A3B"/>
            <TextBlock x:Name="SummaryText"
                       Foreground="#687A8B"
                       Margin="0,5,0,12"/>
        </StackPanel>

        <DataGrid x:Name="ConflictGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Проблема" Binding="{Binding Message}" Width="1.5*"/>
                <DataGridTextColumn Header="Термин A" Binding="{Binding Left.Source}" Width="120"/>
                <DataGridTextColumn Header="Перевод A" Binding="{Binding Left.Translation}" Width="150"/>
                <DataGridTextColumn Header="Приоритет A" Binding="{Binding Left.Priority}" Width="90"/>
                <DataGridTextColumn Header="Термин B" Binding="{Binding Right.Source}" Width="120"/>
                <DataGridTextColumn Header="Перевод B" Binding="{Binding Right.Translation}" Width="150"/>
                <DataGridTextColumn Header="Приоритет B" Binding="{Binding Right.Priority}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Закрыть"
                Width="100"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                IsCancel="True"/>
    </Grid>
</Window>
