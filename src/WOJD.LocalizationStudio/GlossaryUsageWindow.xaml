<Window x:Class="WOJD.LocalizationStudio.GlossaryUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Где используется"
        Width="1050"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#EEF4FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#172A3B"/>
            <TextBlock x:Name="SummaryText"
                       Foreground="#687A8B"
                       Margin="0,5,0,12"/>
        </StackPanel>

        <DataGrid x:Name="UsageGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  MouseDoubleClick="UsageGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Файл" Binding="{Binding Document.FileName}" Width="150"/>
                <DataGridTextColumn Header="Namespace" Binding="{Binding Entry.Namespace}" Width="170"/>
                <DataGridTextColumn Header="Key" Binding="{Binding Entry.Key}" Width="120"/>
                <DataGridTextColumn Header="Оригинал" Binding="{Binding Entry.Source}" Width="1.2*"/>
                <DataGridTextColumn Header="Перевод" Binding="{Binding Entry.Translation}" Width="1.3*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Двойной клик — перейти к строке в редакторе."
                       Foreground="#687A8B"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="Закрыть"
                    Width="100"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
