<Window x:Class="WOJD.LocalizationStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WOJD.LocalizationStudio.Models"
        Title="WOJD Localization Studio" Width="1540" Height="980" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenFolderCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}"/>
    </Window.InputBindings>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0">
                        <TextBlock Text="译" FontSize="22" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="WOJD Localization Studio" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion, Mode=OneWay}" Margin="12,4,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Открыть файл" Command="{Binding OpenFileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                    <Button Content="Открыть папку" Command="{Binding OpenFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                    <Button Content="Проверить обновления" Click="CheckUpdates_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" Padding="18,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Файлы" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,14"/>
                    <TreeView ItemsSource="{Binding FileTree, Mode=OneWay}" BorderThickness="0" Background="Transparent" SelectedItemChanged="FileTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:FileNode}" ItemsSource="{Binding Children, Mode=OneWay}">
                                <Grid Margin="2,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="▸" Margin="0,0,7,0" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding EntryCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource BorderBrushApp}"/>

            <Grid Grid.Column="2" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="280"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="7" Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="⌕" FontSize="24" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="42,12,10,10" VerticalContentAlignment="Center" ToolTip="Поиск по ключу, оригиналу и переводу"/>
                        </Grid>
                    </Border>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters, Mode=OneWay}" SelectedItem="{Binding StatusFilter}" Padding="10,7" BorderBrush="{StaticResource BorderBrushApp}" Background="White"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="13,7" Margin="0,0,8,0">
                        <TextBlock><Run Text="Все  "/><Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/></TextBlock>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="7" Padding="13,7" Margin="0,0,8,0">
                        <TextBlock><Run Text="Без перевода  "/><Run Text="{Binding UntranslatedCount, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/></TextBlock>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="7" Padding="13,7" Margin="0,0,8,0">
                        <TextBlock><Run Text="Переведено  "/><Run Text="{Binding TranslatedCount, Mode=OneWay}" Foreground="#20B66B"/></TextBlock>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="7" Padding="13,7">
                        <TextBlock><Run Text="Изменено  "/><Run Text="{Binding ModifiedCount, Mode=OneWay}" Foreground="#F3A51B"/></TextBlock>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid x:Name="EntriesGrid"
                              ItemsSource="{Binding EntriesView, Mode=OneWay}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              Background="White"
                              AlternatingRowBackground="#FBFCFE"
                              HorizontalGridLinesBrush="#EDF0F5"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" Width="55"/>
                            <DataGridTextColumn Header="Ключ" Binding="{Binding Key, Mode=OneWay}" Width="220"/>
                            <DataGridTextColumn Header="Оригинал" Binding="{Binding Original, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Перевод" Binding="{Binding Translation, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText, Mode=OneWay}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Оригинал" FontWeight="SemiBold" FontSize="16"/>
                        <Border Grid.Row="1" Margin="0,10,14,0" Background="#FAFBFD" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="7" Padding="14">
                            <TextBox Text="{Binding SelectedEntry.Original, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        </Border>

                        <Border Grid.Column="1" Grid.RowSpan="3" Background="{StaticResource BorderBrushApp}"/>

                        <TextBlock Grid.Column="2" Text="Перевод" FontWeight="SemiBold" FontSize="16" Margin="16,0,0,0"/>
                        <Border Grid.Column="2" Grid.Row="1" Margin="16,10,0,0" Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="14">
                            <TextBox x:Name="TranslationBox" Text="{Binding SelectedEntry.Translation, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        </Border>
                        <Grid Grid.Column="2" Grid.Row="2" Margin="16,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}">
                                <Run Text="Символов: "/><Run Text="{Binding SelectedEntry.CharacterCount, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Grid.Column="1" Content="Предыдущая" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Следующая" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                            <Button Grid.Column="3" Content="Применить" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Panel.ZIndex="50"
                Background="#CCFFFFFF">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding BusyText, Mode=OneWay}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <ProgressBar Height="6"
                             IsIndeterminate="True"/>
            </StackPanel>
        </Border>

        <Border x:Name="UpdatePanel"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdateStatusText"
                               Text="Подготовка обновления..."
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdatePercentText"
                               Grid.Column="1"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar x:Name="UpdateProgressBar"
                             Grid.Row="1"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
