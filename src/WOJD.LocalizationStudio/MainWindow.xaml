<Window x:Class="WOJD.LocalizationStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WOJD.LocalizationStudio.Models"
        Title="WOJD Localization Studio" Width="1540" Height="980" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenFolderCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ToggleReplaceCommand}"/>
        <KeyBinding Key="F6" Command="{Binding NextUntranslatedCommand}"/>
        <KeyBinding Key="F6" Modifiers="Shift" Command="{Binding PreviousUntranslatedCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}"/>
    </Window.InputBindings>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FAFBFD"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,0,0,1">
            <Menu Background="Transparent"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Stretch"
                  Margin="10,0,0,0">
                <Menu.Resources>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="12,5"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </Menu.Resources>

                <MenuItem Header="Файл">
                    <MenuItem Header="Открыть файл"
                              Command="{Binding OpenFileCommand}"
                              InputGestureText="Ctrl+O"/>
                    <MenuItem Header="Открыть папку"
                              Command="{Binding OpenFolderCommand}"
                              InputGestureText="Ctrl+Shift+O"/>
                    <Separator/>
                    <MenuItem Header="Сохранить"
                              Command="{Binding SaveCommand}"
                              InputGestureText="Ctrl+S"/>
                    <MenuItem Header="Сохранить всё"
                              Command="{Binding SaveAllCommand}"
                              InputGestureText="Ctrl+Shift+S"/>
                    <Separator/>
                    <MenuItem Header="Экспорт">
                        <MenuItem Header="Выбранные строки…"
                                  Click="ExportSelected_Click"/>
                        <MenuItem Header="Непереведённые…"
                                  Click="ExportUntranslated_Click"/>
                        <MenuItem Header="Ошибки QA…"
                                  Click="ExportErrors_Click"/>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="Правка">
                    <MenuItem Header="Отменить"
                              Command="{Binding UndoCommand}"
                              InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="Повторить"
                              Command="{Binding RedoCommand}"
                              InputGestureText="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="Найти и заменить"
                              Command="{Binding ToggleReplaceCommand}"
                              InputGestureText="Ctrl+H"/>
                    <MenuItem Header="Перейти к строке или ключу…"
                              Click="GoTo_Click"
                              InputGestureText="Ctrl+G"/>
                    <Separator/>
                    <MenuItem Header="Следующая непереведённая"
                              Command="{Binding NextUntranslatedCommand}"
                              InputGestureText="F6"/>
                    <MenuItem Header="Предыдущая непереведённая"
                              Command="{Binding PreviousUntranslatedCommand}"
                              InputGestureText="Shift+F6"/>
                </MenuItem>

                <MenuItem Header="Инструменты">
                    <MenuItem Header="Инструменты проекта…"
                              Click="ProjectTools_Click"/>
                    <MenuItem Header="Поиск по проекту…"
                              Click="ProjectSearch_Click"
                              InputGestureText="Ctrl+Shift+F"/>
                    <MenuItem Header="Массовая замена по проекту…"
                              Click="ProjectReplace_Click"/>
                    <MenuItem Header="Расширенный редактор…"
                              Click="ExpandedEditor_Click"/>
                    <Separator/>
                    <MenuItem Header="Сравнить со старой версией…"
                              Click="CompareFile_Click"/>
                    <Separator/>
                    <MenuItem Header="Настройки…"
                              Click="Settings_Click"/>
                </MenuItem>

                <MenuItem Header="Справка">
                    <MenuItem Header="Проверить обновления"
                              Click="CheckUpdates_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="38"
                            Height="38"
                            CornerRadius="10"
                            Background="{StaticResource AccentSoftBrush}"
                            Margin="0,0,14,0">
                        <TextBlock Text="译"
                                   FontSize="22"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="WOJD Localization Studio"
                               FontSize="23"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion, Mode=OneWay}"
                               Margin="12,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilesColumn" Width="300"/>
                <ColumnDefinition x:Name="FilesDividerColumn" Width="1"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="FilesPanel"
                    Grid.Column="0"
                    Background="White"
                    Padding="12,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Файлы"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="4,0,0,10"/>

                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding FileTree, Mode=OneWay}"
                              BorderThickness="0"
                              Background="Transparent"
                              SelectedItemChanged="FileTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:FileNode}"
                                                      ItemsSource="{Binding Children, Mode=OneWay}">
                                <Grid Margin="2,4">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Закрыть файл"
                                                      Click="CloseFileMenuItem_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="▸"
                                               Margin="0,0,7,0"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding EntryCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"
                                               Margin="8,0,6,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="3"
                                            Content="×"
                                            Width="22"
                                            Height="22"
                                            Margin="2,0,0,0"
                                            Padding="0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#D94C4C"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Закрыть файл"
                                            Click="CloseFileTreeButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CloseFileBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="5">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter TargetName="CloseFileBorder"
                                                                            Property="Background"
                                                                            Value="#FFF0F0"/>
                                                                    <Setter Property="Foreground"
                                                                            Value="#B92E37"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <Border Grid.Row="2"
                            Background="{StaticResource BorderBrushApp}"
                            Margin="0,8"/>

                    <Grid Grid.Row="3"
                          Margin="4,8,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Namespace"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="⚙"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource MutedTextBrush}"
                                Cursor="Hand"
                                ToolTip="Инструменты проекта"
                                Click="ProjectTools_Click"/>
                    </Grid>

                    <TextBox Grid.Row="4"
                             Text="{Binding NamespaceSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             Margin="0,0,0,6"
                             BorderBrush="{StaticResource BorderBrushApp}"
                             BorderThickness="1"
                             ToolTip="Поиск Namespace"/>

                    <ListBox Grid.Row="5"
                             ItemsSource="{Binding NamespaceStats}"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Click="NamespaceStat_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4,5"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        ToolTip="Показать строки этого Namespace">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="★"
                                                       Foreground="#F3A51B"
                                                       Margin="0,0,5,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Favorite}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Namespace}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="8,0,0,0"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                    Background="{StaticResource BorderBrushApp}"/>

            <Border Grid.Column="2"
                    Background="{StaticResource BackgroundBrush}">
                <Button x:Name="FilesPanelToggleButton"
                        Content="‹"
                        Width="20"
                        Height="44"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource MutedTextBrush}"
                        FontSize="18"
                        Cursor="Hand"
                        ToolTip="Скрыть панель файлов"
                        Click="ToggleFilesPanel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ToggleBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="ToggleBorder"
                                            Property="Background"
                                            Value="{StaticResource AccentSoftBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>

            <Grid Grid.Column="3" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="280"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,6">
                    <ItemsControl ItemsSource="{Binding OpenTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,6,0"
                                        Padding="4,2,2,2"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrushApp}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Name}"
                                                Click="OpenTab_Click"
                                                PreviewMouseDown="OpenTab_PreviewMouseDown"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="8,4"
                                                Cursor="Hand"
                                                ToolTip="{Binding FullPath}"/>
                                        <Button Content="📌"
                                                Click="PinTab_Click"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="3"
                                                Cursor="Hand"
                                                ToolTip="Закрепить / открепить"/>
                                        <Button Content="×"
                                                Click="OpenTabClose_Click"
                                                Foreground="#D94C4C"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="5,3"
                                                Cursor="Hand"
                                                ToolTip="Закрыть файл"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrushApp}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <TextBlock Text="⌕"
                                   FontSize="24"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="42,12,10,10"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Поиск по namespace, ключу, оригиналу и переводу"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding FilterAllCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Padding="13,7"
                            Margin="0,0,8,0">
                        <TextBlock>
                            <Run Text="Все  "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Button>

                    <Button Command="{Binding FilterTranslatedCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="13,7"
                            Margin="0,0,8,0">
                        <TextBlock>
                            <Run Text="Переведено  "/>
                            <Run Text="{Binding TranslatedCount, Mode=OneWay}"
                                 Foreground="#20B66B"/>
                        </TextBlock>
                    </Button>

                    <Button Command="{Binding FilterUntranslatedCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="13,7"
                            Margin="0,0,8,0">
                        <TextBlock>
                            <Run Text="Без перевода  "/>
                            <Run Text="{Binding UntranslatedCount, Mode=OneWay}"
                                 Foreground="{StaticResource MutedTextBrush}"/>
                        </TextBlock>
                    </Button>

                    <Button Command="{Binding FilterModifiedCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="13,7"
                            Margin="0,0,8,0">
                        <TextBlock>
                            <Run Text="Изменено  "/>
                            <Run Text="{Binding ModifiedCount, Mode=OneWay}"
                                 Foreground="#F3A51B"/>
                        </TextBlock>
                    </Button>

                    <Button Command="{Binding FilterErrorsCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="13,7"
                            Margin="0,0,12,0">
                        <TextBlock>
                            <Run Text="Ошибки  "/>
                            <Run Text="{Binding ErrorCount, Mode=OneWay}"
                                 Foreground="#D94C4C"/>
                        </TextBlock>
                    </Button>

                </StackPanel>

                <Border Grid.Row="3"
                        Margin="0,4,0,4"
                        Padding="8"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrushApp}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReplacePanelVisible}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Заменить на:"
                                   VerticalAlignment="Center"
                                   Margin="2,0,10,0"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="180"
                                 Padding="8,6"
                                 BorderBrush="{StaticResource BorderBrushApp}"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="Заменить"
                                Command="{Binding ReplaceCurrentCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="12,7"
                                Margin="8,0,0,0"/>
                        <Button Grid.Column="3"
                                Content="Заменить всё"
                                Command="{Binding ReplaceAllCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,7"
                                Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,4,0,6">
                    <Border Margin="0"
                            Padding="10,0,4,0"
                            Height="32"
                            CornerRadius="7"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NamespaceFilter}"
                                                 Value="{x:Null}">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding NamespaceFilterLabel, Mode=OneWay}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Button Command="{Binding ClearNamespaceFilterCommand}"
                                    Content="×"
                                    Width="22"
                                    Height="22"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBrush}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Снять фильтр Namespace">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="6" Background="White" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid x:Name="EntriesGrid"
                              ItemsSource="{Binding EntriesView, Mode=OneWay}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              Background="White"
                              AlternatingRowBackground="#FBFCFE"
                              HorizontalGridLinesBrush="#EDF0F5"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              SelectionChanged="EntriesGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip"
                                        Value="{Binding ValidationSummary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationIssues}"
                                                 Value="True">
                                        <Setter Property="Background"
                                                Value="#FFF1F2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Оригинал → перевод"
                                          Click="CopyOriginalToTranslation_Click"/>
                                <MenuItem Header="Очистить перевод"
                                          Click="ClearSelectedTranslations_Click"/>
                                <Separator/>
                                <MenuItem Header="Экспортировать выбранные…"
                                          Click="ExportSelected_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" Width="55"/>
                            <DataGridTemplateColumn Header="Namespace"
                                                    Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Namespace}"
                                                Command="{Binding DataContext.FilterNamespaceCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding Namespace}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="2,0"
                                                HorizontalContentAlignment="Left"
                                                Foreground="{StaticResource AccentBrush}"
                                                Cursor="Hand"
                                                ToolTip="Показать все строки этого Namespace">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ключ" Binding="{Binding Key, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Оригинал" Binding="{Binding OriginalDisplay, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Перевод" Binding="{Binding Translation, Mode=OneWay}" Width="*"/>
                            <DataGridTemplateColumn Header="QA"
                                                    Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="!"
                                                   FontWeight="Bold"
                                                   Foreground="#D94C4C"
                                                   HorizontalAlignment="Center"
                                                   ToolTip="{Binding ValidationSummary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasValidationIssues}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText, Mode=OneWay}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="8" Margin="0,12,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="42"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Оригинал" FontWeight="SemiBold" FontSize="16"/>
                        <Border Grid.Row="1" Margin="0,10,14,0" Background="#FAFBFD" BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1" CornerRadius="7" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SelectedEntry.OriginalDisplay, Mode=OneWay}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Grid.RowSpan="3" Background="{StaticResource BorderBrushApp}"/>

                        <TextBlock Grid.Column="2" Text="Перевод" FontWeight="SemiBold" FontSize="16" Margin="16,0,0,0"/>
                        <Border Grid.Column="2" Grid.Row="1" Margin="16,10,0,0" Background="White" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="14">
                            <TextBox x:Name="TranslationBox"
                                     Text="{Binding SelectedEntry.Translation, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     ToolTip="{Binding SelectedEntry.CharacterCount, StringFormat=Символов: {0}}"/>
                        </Border>
                        <Grid Grid.Column="2" Grid.Row="2" Margin="16,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SelectedEntry.ValidationSummary, Mode=OneWay}"
                                       Foreground="#D94C4C"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedEntry.ValidationSummary, Mode=OneWay}"/>
                            <Button Grid.Column="1" Content="Предыдущая" Command="{Binding PreviousCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,8,0"/>
                            <Button Grid.Column="2" Content="Следующая" Command="{Binding NextCommand}" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"/>
                            <Button Grid.Column="3"
                                    Content="Развернуть"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,8"
                                    Margin="0,0,8,0"
                                    Click="ExpandedEditor_Click"/>
                            <Button Grid.Column="4"
                                    Content="Применить"
                                    Command="{Binding ApplyCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="18,8"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Panel.ZIndex="50"
                Background="#CCFFFFFF">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding BusyText, Mode=OneWay}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <ProgressBar Height="6"
                             IsIndeterminate="True"/>
            </StackPanel>
        </Border>

        <Border x:Name="UpdatePanel"
                Grid.Row="3"
                Visibility="Collapsed"
                Background="White"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdateStatusText"
                               Text="Подготовка обновления..."
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdatePercentText"
                               Grid.Column="1"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar x:Name="UpdateProgressBar"
                             Grid.Row="1"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
