<Window x:Class="WOJD.LocalizationStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WOJD.LocalizationStudio.Models"
        Title="WOJD Localization Studio"
        Width="1540" Height="980"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenFolderCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ToggleReplaceCommand}"/>
        <KeyBinding Key="F6" Command="{Binding NextUntranslatedCommand}"/>
        <KeyBinding Key="F6" Modifiers="Shift" Command="{Binding PreviousUntranslatedCommand}"/>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}"/>
    </Window.InputBindings>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FAFBFD"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,0,0,1">
            <Menu Background="Transparent"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Stretch"
                  Margin="10,0,0,0">
                <Menu.Resources>
                    <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Padding" Value="12,5"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </Menu.Resources>

                <MenuItem Header="Файл">
                    <MenuItem Header="Открыть файл"
                              Command="{Binding OpenFileCommand}"
                              InputGestureText="Ctrl+O"/>
                    <MenuItem Header="Открыть папку"
                              Command="{Binding OpenFolderCommand}"
                              InputGestureText="Ctrl+Shift+O"/>
                    <Separator/>
                    <MenuItem Header="Сохранить"
                              Command="{Binding SaveCommand}"
                              InputGestureText="Ctrl+S"/>
                    <MenuItem Header="Сохранить всё"
                              Command="{Binding SaveAllCommand}"
                              InputGestureText="Ctrl+Shift+S"/>
                    <Separator/>
                    <MenuItem Header="Экспорт">
                        <MenuItem Header="Выбранные строки…" Click="ExportSelected_Click"/>
                        <MenuItem Header="Непереведённые…" Click="ExportUntranslated_Click"/>
                        <MenuItem Header="Ошибки QA…" Click="ExportErrors_Click"/>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="Правка">
                    <MenuItem Header="Отменить" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
                    <MenuItem Header="Повторить" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
                    <Separator/>
                    <MenuItem Header="Найти и заменить" Command="{Binding ToggleReplaceCommand}" InputGestureText="Ctrl+H"/>
                    <MenuItem Header="Перейти к строке или ключу…" Click="GoTo_Click" InputGestureText="Ctrl+G"/>
                    <Separator/>
                    <MenuItem Header="Следующая непереведённая" Command="{Binding NextUntranslatedCommand}" InputGestureText="F6"/>
                    <MenuItem Header="Предыдущая непереведённая" Command="{Binding PreviousUntranslatedCommand}" InputGestureText="Shift+F6"/>
                    <Separator/>
                    <MenuItem Header="История строки…" Click="EntryHistoryMenu_Click"/>
                    <MenuItem Header="История проекта…" Click="ProjectHistory_Click"/>
                    <MenuItem Header="Снимки файла…" Click="SnapshotsMenu_Click"/>
                </MenuItem>

                <MenuItem Header="Инструменты">
                    <MenuItem Header="Поиск по проекту…" Click="ProjectSearch_Click" InputGestureText="Ctrl+Shift+F"/>
                    <Separator/>
                    <MenuItem Header="Сравнить со старой версией…" Click="CompareFile_Click"/>
                    <MenuItem Header="Проверка согласованности…" Click="Consistency_Click"/>
                    <MenuItem Header="Translation Memory…" Click="TranslationMemory_Click"/>
                    <MenuItem Header="Глоссарий…" Click="Glossary_Click"/>
                    <MenuItem Header="QA-профили…" Click="QaProfilesMenu_Click"/>
                    <Separator/>
                    <MenuItem Header="Настройки редактора…" Click="EditorSettings_Click"/>
                </MenuItem>

                <MenuItem Header="Справка">
                    <MenuItem Header="Проверить обновления" Click="CheckUpdates_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource AccentSoftBrush}"
                            Margin="0,0,14,0">
                        <TextBlock Text="译" FontSize="22"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="WOJD Localization Studio"
                               FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion, Mode=OneWay}"
                               Margin="12,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilesColumn" Width="300"/>
                <ColumnDefinition x:Name="FilesDividerColumn" Width="1"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="FilesPanel" Grid.Column="0" Background="White" Padding="14,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Файлы"
                               FontSize="18" FontWeight="SemiBold" Margin="4,0,0,14"/>
                    <TreeView ItemsSource="{Binding FileTree, Mode=OneWay}"
                              BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="FileTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:FileNode}"
                                                      ItemsSource="{Binding Children, Mode=OneWay}">
                                <Grid Margin="2,5">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Закрыть файл" Click="CloseFileMenuItem_Click"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="▸" Margin="0,0,7,0"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding EntryCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                               FontWeight="SemiBold" Margin="8,0,6,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="3" Content="×"
                                            Width="22" Height="22" Padding="0"
                                            Foreground="#D94C4C" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand"
                                            ToolTip="Закрыть файл" Click="CloseFileTreeButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BorderBrushApp}"/>

            <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}">
                <Button x:Name="FilesPanelToggleButton"
                        Content="‹" Width="20" Height="44"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource MutedTextBrush}"
                        FontSize="18" Cursor="Hand"
                        ToolTip="Скрыть панель файлов"
                        Click="ToggleFilesPanel_Click"/>
            </Border>

            <Grid Grid.Column="3" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="EditorSplitterRow" Height="6"/>
                    <RowDefinition x:Name="EditorRow" Height="320" MinHeight="0"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
                    <Button Command="{Binding FilterAllCommand}" Style="{StaticResource PrimaryButton}"
                            Padding="13,7" Margin="0,0,8,4">
                        <TextBlock><Run Text="Все  "/><Run Text="{Binding TotalCount, Mode=OneWay}"/></TextBlock>
                    </Button>
                    <Button Command="{Binding FilterTranslatedCommand}" Style="{StaticResource SecondaryButton}"
                            Padding="13,7" Margin="0,0,8,4">
                        <TextBlock><Run Text="Переведено  "/><Run Text="{Binding TranslatedCount, Mode=OneWay}" Foreground="#20B66B"/></TextBlock>
                    </Button>
                    <Button Command="{Binding FilterUntranslatedCommand}" Style="{StaticResource SecondaryButton}"
                            Padding="13,7" Margin="0,0,8,4">
                        <TextBlock><Run Text="Без перевода  "/><Run Text="{Binding UntranslatedCount, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}"/></TextBlock>
                    </Button>
                    <Button Command="{Binding FilterModifiedCommand}" Style="{StaticResource SecondaryButton}"
                            Padding="13,7" Margin="0,0,8,4">
                        <TextBlock><Run Text="Изменено  "/><Run Text="{Binding ModifiedCount, Mode=OneWay}" Foreground="#F3A51B"/></TextBlock>
                    </Button>
                    <Button Command="{Binding FilterErrorsCommand}" Style="{StaticResource SecondaryButton}"
                            Padding="13,7" Margin="0,0,8,4">
                        <TextBlock><Run Text="Ошибки  "/><Run Text="{Binding ErrorCount, Mode=OneWay}" Foreground="#D94C4C"/></TextBlock>
                    </Button>
                    <Button x:Name="QaTagsFilterButton" Content="Теги"
                            Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,8,4"/>
                    <Button x:Name="QaPlaceholdersFilterButton" Content="Плейсхолдеры"
                            Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,8,4"/>
                    <Button x:Name="QaNewLinesFilterButton" Content="Переносы"
                            Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,8,4"/>
                    <ComboBox x:Name="ReviewFilterCombo" Width="178" Height="34"
                              VerticalContentAlignment="Center" Margin="0,0,8,4"/>
                </WrapPanel>

                <Border Grid.Row="1" Background="White"
                        BorderBrush="{StaticResource BorderBrushApp}"
                        BorderThickness="1" CornerRadius="7">
                    <Grid>
                        <TextBlock Text="⌕" FontSize="24"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="42,12,10,10" VerticalContentAlignment="Center"
                                 ToolTip="Поиск по namespace, ключу, оригиналу и переводу"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,4,0,4" Padding="8"
                        Background="White" BorderBrush="{StaticResource BorderBrushApp}"
                        BorderThickness="1" CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReplacePanelVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Заменить на:" VerticalAlignment="Center"
                                   Margin="2,0,10,0" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="180" Padding="8,6"
                                 BorderBrush="{StaticResource BorderBrushApp}" BorderThickness="1"/>
                        <Button Grid.Column="2" Content="Заменить"
                                Command="{Binding ReplaceCurrentCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="8,0,0,0"/>
                        <Button Grid.Column="3" Content="Заменить всё"
                                Command="{Binding ReplaceAllCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,4,0,6">
                    <Border Padding="10,0,4,0" Height="32" CornerRadius="7"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NamespaceFilter}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NamespaceFilterLabel, Mode=OneWay}"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Command="{Binding ClearNamespaceFilterCommand}"
                                    Content="×" Width="22" Height="22" Margin="6,0,0,0"
                                    Padding="0" FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBrush}"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip="Снять фильтр Namespace"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="4" Background="White"
                        BorderBrush="{StaticResource BorderBrushApp}"
                        BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <DataGrid x:Name="EntriesGrid"
                              ItemsSource="{Binding EntriesView, Mode=OneWay}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" BorderThickness="0"
                              Background="White" AlternatingRowBackground="#FBFCFE"
                              HorizontalGridLinesBrush="#EDF0F5"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              SelectionChanged="EntriesGrid_SelectionChanged">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding ValidationSummary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasValidationIssues}" Value="True">
                                        <Setter Property="Background" Value="#FFF1F2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Оригинал → перевод" Click="CopyOriginalToTranslation_Click"/>
                                <MenuItem Header="Очистить перевод" Click="ClearSelectedTranslations_Click"/>
                                <Separator/>
                                <MenuItem Header="Translation Memory…" Click="TranslationMemoryContext_Click"/>
                                <MenuItem Header="Показать различия структуры…" Click="StructureDiffContext_Click"/>
                                <Separator/>
                                <MenuItem Header="Экспортировать выбранные…" Click="ExportSelected_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" Width="55"/>
                            <DataGridTemplateColumn x:Name="NamespaceColumn" Header="Namespace" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Namespace}"
                                                Command="{Binding DataContext.FilterNamespaceCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding Namespace}"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="2,0" HorizontalContentAlignment="Left"
                                                Foreground="{StaticResource AccentBrush}" Cursor="Hand"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="KeyColumn" Header="Ключ" Binding="{Binding Key, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Оригинал" Binding="{Binding OriginalDisplay, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Перевод" Binding="{Binding Translation, Mode=OneWay}" Width="*"/>
                            <DataGridTemplateColumn Header="QA" Width="48">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding QaIndicator}"
                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                   ToolTip="{Binding ValidationSummary}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="StatusColumn" Header="Статус"
                                                Binding="{Binding StatusText, Mode=OneWay}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <GridSplitter x:Name="EditorSplitter"
                              Grid.Row="5" Height="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              DragCompleted="EditorSplitter_DragCompleted"/>

                <Border x:Name="EditorPaneBorder"
                        Grid.Row="6" Background="White"
                        BorderBrush="{StaticResource BorderBrushApp}"
                        BorderThickness="1" CornerRadius="8"
                        Margin="0,8,0,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OriginalEditorColumn" Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.ColumnSpan="3" LastChildFill="False">
                            <Button x:Name="ToggleEditorButton"
                                    DockPanel.Dock="Right" Content="Свернуть редактор"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5"
                                    Click="ToggleEditor_Click"/>
                        </DockPanel>

                        <TextBlock Grid.Row="0" Text="Оригинал"
                                   FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="Перевод"
                                   FontWeight="SemiBold" FontSize="16"
                                   Margin="16,0,0,0" VerticalAlignment="Center"/>

                        <Border Grid.Row="1" Margin="0,10,14,0"
                                Background="#FAFBFD" BorderBrush="{StaticResource BorderBrushApp}"
                                BorderThickness="1" CornerRadius="7" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SelectedEntry.OriginalDisplay, Mode=OneWay}"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="3"
                                Background="{StaticResource BorderBrushApp}"/>

                        <Border x:Name="TranslationEditorBorder"
                                Grid.Column="2" Grid.Row="1" Margin="16,10,0,0"
                                Background="White" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="14">
                            <TextBox x:Name="TranslationBox"
                                     Text="{Binding SelectedEntry.Translation, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="14" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        </Border>

                        <Border x:Name="StructureQaBorder"
                                Grid.Column="2" Grid.Row="2" Margin="16,8,0,0"
                                CornerRadius="6" BorderThickness="1"
                                BorderBrush="#D8E2EF" Background="#F8FAFC"
                                Padding="9,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StructureQaText"
                                           Text="Структура: выберите строку для проверки."
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="PrevStructureButton" Grid.Column="1"
                                        Content="←" ToolTip="Предыдущая структурная ошибка"
                                        Style="{StaticResource SecondaryButton}" Padding="9,4" Margin="8,0,4,0"/>
                                <Button x:Name="NextStructureButton" Grid.Column="2"
                                        Content="→" ToolTip="Следующая структурная ошибка"
                                        Style="{StaticResource SecondaryButton}" Padding="9,4" Margin="0,0,4,0"/>
                                <Button x:Name="StructureDiffButton" Grid.Column="3"
                                        Content="Различия" ToolTip="Показать теги и плейсхолдеры с подсветкой"
                                        Style="{StaticResource SecondaryButton}" Padding="9,4" Margin="0,0,4,0"
                                        Click="StructureDiff_Click"/>
                                <Button x:Name="RestoreStructureButton" Grid.Column="4"
                                        Content="↺ Структура" ToolTip="Восстановить доказуемо повреждённую структуру"
                                        Style="{StaticResource SecondaryButton}" Padding="9,4" Margin="0,0,6,0"/>
                                <CheckBox x:Name="ProtectionToggle" Grid.Column="5"
                                          Content="Защита" IsChecked="True" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="2" Grid.Row="3" Margin="16,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AutoCorrectButton" Content="Автоисправить"
                                    Style="{StaticResource PrimaryButton}" Padding="14,8"/>
                            <Button x:Name="BulkAutoCorrectButton" Grid.Column="1" Content="Массово…"
                                    Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0"/>
                            <Button x:Name="AiReviewButton" Grid.Column="2" Content="ИИ-проверка"
                                    Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="8,0,0,0"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Проверка:" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <ComboBox x:Name="ReviewStatusCombo" Width="145" Height="32"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Panel.ZIndex="50" Background="#CCFFFFFF">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding BusyText, Mode=OneWay}"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ProgressBar Height="6" IsIndeterminate="True"/>
            </StackPanel>
        </Border>

        <Border x:Name="UpdatePanel" Grid.Row="3" Visibility="Collapsed"
                Background="White" BorderBrush="{StaticResource BorderBrushApp}"
                BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdateStatusText" Text="Подготовка обновления..."
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdatePercentText" Grid.Column="1"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="16,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar x:Name="UpdateProgressBar" Grid.Row="1"
                             Height="6" Minimum="0" Maximum="100" Value="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
