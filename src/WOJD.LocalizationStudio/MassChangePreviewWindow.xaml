<Window x:Class="WOJD.LocalizationStudio.MassChangePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предпросмотр массовых изменений"
        Width="1180"
        Height="700"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#EEF4FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="Предпросмотр изменений"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#172A3B"/>
                <TextBlock x:Name="SummaryText"
                           Foreground="#687A8B"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Выбрать всё"
                        Click="SelectAllButton_Click"/>
                <Button Content="Снять всё"
                        Margin="8,0,0,0"
                        Click="ClearAllButton_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="ChangesGrid"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  RowHeaderWidth="0"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓"
                                        Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="45"/>
                <DataGridTextColumn Header="Файл"
                                    Binding="{Binding FileName}"
                                    IsReadOnly="True"
                                    Width="135"/>
                <DataGridTextColumn Header="Namespace"
                                    Binding="{Binding Namespace}"
                                    IsReadOnly="True"
                                    Width="150"/>
                <DataGridTextColumn Header="Key"
                                    Binding="{Binding Key}"
                                    IsReadOnly="True"
                                    Width="110"/>
                <DataGridTextColumn Header="Было"
                                    Binding="{Binding Before}"
                                    IsReadOnly="True"
                                    Width="1.4*"/>
                <DataGridTextColumn Header="Станет"
                                    Binding="{Binding After}"
                                    IsReadOnly="True"
                                    Width="1.4*"/>
                <DataGridTextColumn Header="Причина"
                                    Binding="{Binding Reason}"
                                    IsReadOnly="True"
                                    Width="1.0*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Изменения не применяются, пока вы не нажмёте «Применить выбранные»."
                       Foreground="#687A8B"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Отмена"
                        Width="90"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Content="Применить выбранные"
                        Width="170"
                        Background="#2F7BEA"
                        Foreground="White"
                        BorderBrush="#266ACB"
                        Click="ApplyButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
