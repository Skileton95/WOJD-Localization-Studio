<Window x:Class="WOJD.LocalizationStudio.TranslationVariantsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Варианты перевода"
        Width="760"
        Height="590"
        MinWidth="620"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Варианты перевода ChatGPT"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#1C2E3E"/>

        <TextBlock x:Name="SourceText"
                   Grid.Row="1"
                   Margin="0,6,0,14"
                   Foreground="#687A8B"
                   TextWrapping="Wrap"/>

        <ListBox x:Name="VariantsList"
                 Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Single"
                 MouseDoubleClick="VariantsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White"
                            BorderBrush="#D7E2EC"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12"
                            Margin="0,0,0,8">
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   Foreground="#26394A"
                                   FontSize="14"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Отмена"
                    Width="90"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Использовать выбранный"
                    Width="165"
                    Background="#2F7BEA"
                    Foreground="White"
                    BorderBrush="#266ACB"
                    Click="UseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
